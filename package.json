{
  "name": "pecuaria",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema pessoal de gestão pecuária, desktop e offline.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pecuaria/desktop",
    "build": "npm run build -w @pecuaria/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @pecuaria/desktop",
    "package:win": "npm run package:win -w @pecuaria/desktop",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
