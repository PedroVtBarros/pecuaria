{
  "name": "@pecuaria/desktop",
  "productName": "Gestão Pecuária",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicativo desktop de gestão pecuária, offline.",
  "author": "Usuário",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
